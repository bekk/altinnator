# Becomes the ConfigMap altinnator-texas: the settings of Texas (https://github.com/nais/texas) that are not secret. The
# key is in maskinporten.env.
#
# Texas runs in a container, where the mock on your host is host.docker.internal. The issuer stays localhost, since
# Texas sends it as the grant's audience and the mock only accepts its own issuer. Texas will not start without a JWKS,
# which it only uses to check tokens it is asked to introspect, and the mock has none, so it gets test Maskinporten's
# public one.
MASKINPORTEN_CLIENT_ID=dev-client
MASKINPORTEN_ISSUER=http://localhost:8090/
MASKINPORTEN_TOKEN_ENDPOINT=http://host.docker.internal:8090/token
MASKINPORTEN_JWKS_URI=https://test.maskinporten.no/jwk
